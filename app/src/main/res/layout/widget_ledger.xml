<?xml version="1.0" encoding="utf-8"?>
<!-- Home-screen widget: parchment card with this month's total and goal bars. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_heading"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:maxLines="1"
            android:text="@string/app_name"
            android:textColor="@color/widget_heading"
            android:textSize="13sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_add"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_add_background"
            android:contentDescription="@string/widget_add"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/widget_on_accent"
            android:textSize="22sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:textColor="@color/widget_heading"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:textColor="@color/widget_soft"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_trip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="6dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/widget_heading"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout android:id="@+id/widget_ward1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_ward1_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="12sp" />
        <ProgressBar android:id="@+id/widget_ward1_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginBottom="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_ward2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_ward2_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="12sp" />
        <ProgressBar android:id="@+id/widget_ward2_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginBottom="4dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
    </LinearLayout>

    <LinearLayout android:id="@+id/widget_ward3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
        <TextView android:id="@+id/widget_ward3_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:textColor="@color/widget_ink" android:textSize="12sp" />
        <ProgressBar android:id="@+id/widget_ward3_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="8dp" android:max="100" android:progressDrawable="@drawable/widget_bar" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_empty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/widget_soft"
        android:textSize="12sp"
        android:visibility="gone" />
</LinearLayout>
